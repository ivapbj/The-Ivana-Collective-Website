{
  "redirects": [
    {
      "source": "/portfolio",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/method",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:page(work|services|pricing|about|contact|website-generator)",
      "destination": "/index.html"
    },
    {
      "source": "/services/:service(web-design|seo|content-growth)",
      "destination": "/index.html"
    }
  ]
}
